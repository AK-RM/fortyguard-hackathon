diff --git a/src/lib/transition-exposure.ts b/src/lib/transition-exposure.ts
new file mode 100644
index 0000000..cf4dc5d
--- /dev/null
+++ b/src/lib/transition-exposure.ts
@@ -0,0 +1,113 @@
+import {
+  HEAT_THRESHOLDS,
+  WEIGHTS,
+} from "@/lib/heat-discharge-risk";
+import type { EnvironmentalInput } from "@/lib/heat-discharge-risk";
+import type { TransportMode } from "@/types/discharge-workflow";
+
+export type TransitionExposureResult = {
+  id: "transition-exposure";
+  points: number;
+  label: string;
+  explanation: string;
+  transportMode: TransportMode;
+  durationMinutes: number;
+  transportExposureFactor: number;
+  durationFactor: number;
+  destinationHeatTier: "low" | "moderate" | "high";
+};
+
+const TRANSPORT_EXPOSURE_FACTORS: Record<TransportMode, number> = {
+  ac_private_vehicle: 0.15,
+  ambulance: 0.2,
+  taxi_rideshare: 0.35,
+  other: 0.5,
+  public_bus: 0.75,
+  walking: 1,
+};
+
+export const TRANSPORT_MODE_LABELS: Record<TransportMode, string> = {
+  ac_private_vehicle: "Air-conditioned private vehicle",
+  taxi_rideshare: "Taxi / rideshare",
+  ambulance: "Ambulance / medical transport",
+  public_bus: "Public bus",
+  walking: "Walking",
+  other: "Other",
+};
+
+function getDestinationHeatTier(environmental: EnvironmentalInput) {
+  if (
+    environmental.meanTemperature >= HEAT_THRESHOLDS.meanHigh ||
+    environmental.maximumTemperature >= HEAT_THRESHOLDS.maxHigh
+  ) {
+    return "high" as const;
+  }
+
+  if (
+    environmental.meanTemperature >= HEAT_THRESHOLDS.meanModerate ||
+    environmental.maximumTemperature >= HEAT_THRESHOLDS.maxModerate
+  ) {
+    return "moderate" as const;
+  }
+
+  return "low" as const;
+}
+
+function getBaseTransitionPoints(tier: "low" | "moderate" | "high") {
+  switch (tier) {
+    case "high":
+      return WEIGHTS.environmental.transitionHigh;
+    case "moderate":
+      return WEIGHTS.environmental.transitionModerate;
+    default:
+      return WEIGHTS.environmental.transitionLow;
+  }
+}
+
+function getDurationFactor(durationMinutes: number) {
+  if (durationMinutes <= 15) {
+    return 0.5;
+  }
+
+  if (durationMinutes <= 30) {
+    return 0.75;
+  }
+
+  if (durationMinutes <= 45) {
+    return 1;
+  }
+
+  return 1.25;
+}
+
+/**
+ * Deterministic transition exposure heuristic.
+ * Uses destination environmental heat, transport mode, and configured journey duration.
+ * Does not fabricate route geometry or origin-specific temperature observations.
+ */
+export function calculateTransitionExposure(input: {
+  destinationEnvironmental: EnvironmentalInput;
+  transportMode: TransportMode;
+  durationMinutes: number;
+}): TransitionExposureResult {
+  const destinationHeatTier = getDestinationHeatTier(input.destinationEnvironmental);
+  const basePoints = getBaseTransitionPoints(destinationHeatTier);
+  const transportExposureFactor = TRANSPORT_EXPOSURE_FACTORS[input.transportMode];
+  const durationFactor = getDurationFactor(input.durationMinutes);
+  const rawPoints = basePoints * transportExposureFactor * durationFactor;
+  const points = Math.max(0, Math.round(rawPoints));
+
+  const transportLabel = TRANSPORT_MODE_LABELS[input.transportMode].toLowerCase();
+
+  return {
+    id: "transition-exposure",
+    points,
+    label: "Transition exposure",
+    explanation: `Hospital-to-home transition (${transportLabel}, ${input.durationMinutes} min configured duration) adds workflow exposure based on destination heat conditions. Journey duration is coordinator-entered data, not a calculated route.`,
+    transportMode: input.transportMode,
+    durationMinutes: input.durationMinutes,
+    transportExposureFactor,
+    durationFactor,
+    destinationHeatTier,
+  };
+}
