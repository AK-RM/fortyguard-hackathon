+"use client";
+
+import { useCallback, useState } from "react";
+
+import type { PersistedDischargeState } from "@/lib/discharge-storage";
+import {
+  createInitialPersistedState,
+  isBrowserEnvironment,
+  loadPersistedState,
+  savePersistedState,
+} from "@/lib/discharge-storage";
+
+function readInitialState(): PersistedDischargeState | null {
+  if (!isBrowserEnvironment()) {
+    return null;
+  }
+
+  return loadPersistedState();
+}
+
+export function useDischargeStorage() {
+  const [state, setState] = useState<PersistedDischargeState | null>(readInitialState);
+
+  const persist = useCallback((next: PersistedDischargeState) => {
+    setState(next);
+    savePersistedState(next);
+  }, []);
+
+  const resetToInitial = useCallback(() => {
+    const initial = createInitialPersistedState();
+    persist(initial);
+  }, [persist]);
+
+  return {
+    state,
+    ready: state !== null,
+    persist,
+    resetToInitial,
+  };
+}
